{
  "realm": "baiganio",
  "enabled": true,
  "displayName": "BaiGanio",
  "registrationAllowed": false,
  "rememberMe": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(8) and notUsername and notEmail and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1)",
  "eventsEnabled": true,
  "eventsExpiration": 15552000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "clients": [
    {
      "clientId": "bgapi-api",
      "name": "bgapi resource API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "bgapi-swagger",
      "name": "bgapi Swagger UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "bgapi-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "bgapi-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "redirectUris": [
        "${SWAGGER_REDIRECT_URI_PUBLIC}",
        "${SWAGGER_REDIRECT_URI_AZURE}",
        "${SWAGGER_REDIRECT_URI_LOCAL}"
      ],
      "webOrigins": [
        "${SWAGGER_ORIGIN_PUBLIC}",
        "${SWAGGER_ORIGIN_AZURE}",
        "${SWAGGER_ORIGIN_LOCAL}"
      ],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "baiganio-web",
      "name": "BaiGanio web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "bgapi-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "bgapi-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "redirectUris": [
        "${BAIGANIO_REDIRECT_URI_PUBLIC}",
        "${BAIGANIO_REDIRECT_URI_LOCAL}"
      ],
      "webOrigins": [
        "${BAIGANIO_ORIGIN_PUBLIC}",
        "${BAIGANIO_ORIGIN_LOCAL}"
      ],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "cosmic-origins-web",
      "name": "Cosmic Origins web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "bgapi-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "bgapi-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "redirectUris": [
        "${COSMIC_ORIGINS_REDIRECT_URI_PUBLIC}",
        "${COSMIC_ORIGINS_REDIRECT_URI_LOCAL}"
      ],
      "webOrigins": [
        "${COSMIC_ORIGINS_ORIGIN_PUBLIC}",
        "${COSMIC_ORIGINS_ORIGIN_LOCAL}"
      ],
      "attributes": { "pkce.code.challenge.method": "S256" }
    }
  ],
  "users": [
    {
      "username": "swagger@baiganio.io",
      "email": "swagger@baiganio.io",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${BGAPI_SWAGGER_PASSWORD}",
          "temporary": false
        }
      ],
      "clientRoles": {
        "bgapi-api": ["viewer"]
      }
    }
  ],
  "roles": {
    "client": {
      "bgapi-api": [
        { "name": "admin", "description": "Full API access" },
        { "name": "user", "description": "Standard API access" },
        { "name": "viewer", "description": "Read-only API access" }
      ]
    }
  },
  "attributes": {
    "frontendUrl": "${REALM_FRONTEND_URL}"
  }
}
