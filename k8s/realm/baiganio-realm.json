{
  "realm": "baiganio",
  "enabled": true,
  "displayName": "BaiGanio",
  "registrationAllowed": false,
  "rememberMe": true,
  "clients": [
    {
      "clientId": "bgapi-api",
      "name": "bgapi resource API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "bgapi-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "bgapi-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "bgapi-swagger",
      "name": "bgapi Swagger UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "${SWAGGER_REDIRECT_URI_PUBLIC}",
        "${SWAGGER_REDIRECT_URI_AZURE}",
        "${SWAGGER_REDIRECT_URI_LOCAL}"
      ],
      "webOrigins": [
        "${SWAGGER_ORIGIN_PUBLIC}",
        "${SWAGGER_ORIGIN_AZURE}",
        "${SWAGGER_ORIGIN_LOCAL}"
      ],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "baiganio-web",
      "name": "BaiGanio web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "${BAIGANIO_REDIRECT_URI_PUBLIC}",
        "${BAIGANIO_REDIRECT_URI_LOCAL}"
      ],
      "webOrigins": [
        "${BAIGANIO_ORIGIN_PUBLIC}",
        "${BAIGANIO_ORIGIN_LOCAL}"
      ],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "cosmic-origins-web",
      "name": "Cosmic Origins web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "${COSMIC_ORIGINS_REDIRECT_URI_PUBLIC}",
        "${COSMIC_ORIGINS_REDIRECT_URI_LOCAL}"
      ],
      "webOrigins": [
        "${COSMIC_ORIGINS_ORIGIN_PUBLIC}",
        "${COSMIC_ORIGINS_ORIGIN_LOCAL}"
      ],
      "attributes": { "pkce.code.challenge.method": "S256" }
    }
  ],
  "roles": {
    "client": {
      "bgapi-api": [
        { "name": "admin", "description": "Full API access" },
        { "name": "user", "description": "Standard API access" },
        { "name": "viewer", "description": "Read-only API access" }
      ]
    }
  },
  "attributes": {
    "frontendUrl": "${REALM_FRONTEND_URL}"
  }
}
